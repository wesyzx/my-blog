# 复制为 .env.local 后填入真实值。.env.local 已被 .gitignore 忽略，不要提交。
# 注意：EdgeOne 等部署环境需要单独配置同名变量，否则线上功能会静默失效。

# --- Notion（美食 / 相册使用）--------------------------------------------
# 博文默认来自 Obsidian。关于页固定读取本地 content/about.md。
NOTION_TOKEN=

# --- 高德地图（可选）------------------------------------------------------
# 仅用于给美食条目做地址地理编码。缺失时经纬度会退化为 0,0。
AMAP_KEY=

# --- Memos 短记（必需，缺失会导致短记页面停留在旧快照）--------------------
# Memos 实例的 Access Token。在 Memos 里 Settings → Access Tokens 生成，
# 默认有效期只有 7 天，建议选长期或不过期。匿名请求会返回 401。
MEMOS_TOKEN=

# 以下三个一般不用改，留空即用代码里的默认值。
# Memos 实例地址，默认 https://memos.guanyan.me
MEMOS_BASE_URL=
# Memos API 端点，默认 ${MEMOS_BASE_URL}/api/v1/memos
MEMOS_API_URL=
# 设为 1 时，Memos 同步失败会让构建直接失败，而不是沿用旧快照。
MEMOS_STRICT=

# --- 内容构建开关（可选）--------------------------------------------------
# Notion 里一篇已发布文章都没有时，默认沿用上一版快照并继续构建（不会让部署失败）。
# 设为 1 表示接受空列表，会把线上文章清空。
CONTENT_ALLOW_EMPTY=

# 博文内容源：留空读取 content/source.json（当前 obsidian）；notion 可显式回退。
CONTENT_SOURCE=
# Obsidian Vault 内独立的 Blog 发布区（不是整个 Vault）；默认使用仓库内 content/obsidian。
OBSIDIAN_BLOG_DIR=
# 可选：附件已经位于独立的 HTTPS 静态存储时填写。留空时使用站点 /obsidian。
OBSIDIAN_ATTACHMENT_BASE_URL=

# --- 腾讯地图（美食地图 / 运动轨迹地图必需）--------------------------------
# 腾讯位置服务控制台 → 创建应用 → 申请「Web 端 (JavaScript API GL)」类型的 Key。
# 必须配置 Referer 白名单（填站点域名），否则 Key 会被盗用。
# 不配置时地图位置会显示一段申请说明，而不是白屏。
NEXT_PUBLIC_TMAP_KEY=
# 仅运动地图使用：Key 在控制台绑定的样式 ID，例如 style1、style2；未绑定时留空。
# 美食和 Memos 短记使用 SDK 原始底图，不受这个变量影响。
NEXT_PUBLIC_TMAP_STYLE_ID=

# Memos 短记的经纬度转中文地名。使用单独启用了「WebService API」的服务端 Key。
# 服务端调用不带浏览器 Referer；此 Key 不要配置浏览器域名白名单，否则返回 110。
# NEXT_PUBLIC_TMAP_KEY 的浏览器域名白名单仍需保留。
# .env.local 不会上传；部署环境也要单独配置此变量并重新部署。
# 不配置时短记仍会显示地图，只是地名保留为经纬度。
TMAP_SERVER_KEY=
