# 复制为 .env.local 后填入真实值。.env.local 已被 .gitignore 忽略，不要提交。
# 注意：EdgeOne 等部署环境需要单独配置同名变量，否则线上功能会静默失效。

# --- Notion（仅手动回退到 Notion 时需要）---------------------------------
# 博文、美食与相册默认来自同一 Obsidian Vault。关于页读取本地 content/about.md。
NOTION_TOKEN=

# --- 高德地图（可选）------------------------------------------------------
# 仅用于给美食条目做地址地理编码。缺失时经纬度会退化为 0,0。
AMAP_KEY=

# --- 内容构建开关（可选）--------------------------------------------------
# Obsidian 的已有板块变为空时默认拒绝构建；Notion 请求异常时沿用旧快照。
# 设为 1 表示构建时接受空列表；服务器发布器仍会拦截整板块被清空。
CONTENT_ALLOW_EMPTY=

# 博文内容源：留空读取 content/source.json（当前 obsidian）；notion 可显式回退。
CONTENT_SOURCE=
# 美食：当前为 obsidian。
FOOD_CONTENT_SOURCE=
# 相册：当前为 hybrid（Obsidian + 已发布的 R2 相册）；也可设为 obsidian 或 r2。
GALLERY_CONTENT_SOURCE=
# 可选：构建时读取已发布 R2 相册的清单地址。
GALLERY_MANIFEST_URL=
# Obsidian Vault 内独立的 Blog 发布区（不是整个 Vault）；默认使用仓库内 content/obsidian。
OBSIDIAN_BLOG_DIR=
# 可选：附件已经位于独立的 HTTPS 静态存储时填写。留空时使用站点 /obsidian。
OBSIDIAN_ATTACHMENT_BASE_URL=

# --- iPhone 相册快捷指令 ----------------------------------------------------
# 只用于生成带令牌的个人版快捷指令，以及作为 Worker secret。
# 公开版快捷指令在每次运行时询问令牌，不把真实值写进仓库或公开文件。
GALLERY_UPLOAD_TOKEN=
# Worker 发布相册时调用的 EdgeOne 部署 webhook；必须同时配置为 Worker secret。
EDGEONE_DEPLOY_WEBHOOK=

# --- 腾讯地图（美食地图 / 运动轨迹地图必需）--------------------------------
# 腾讯位置服务控制台 → 创建应用 → 申请「Web 端 (JavaScript API GL)」类型的 Key。
# 必须配置 Referer 白名单（填站点域名），否则 Key 会被盗用。
# 不配置时地图位置会显示一段申请说明，而不是白屏。
NEXT_PUBLIC_TMAP_KEY=
# 仅运动地图使用：Key 在控制台绑定的样式 ID，例如 style1、style2；未绑定时留空。
# 美食地图使用 SDK 原始底图，不受这个变量影响。
NEXT_PUBLIC_TMAP_STYLE_ID=
