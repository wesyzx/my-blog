{
  "name": "blog-image-webp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "img.215320.xyz/*",
      "zone_name": "215320.xyz"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "blog-images"
    },
    {
      "binding": "METADATA_BUCKET",
      "bucket_name": "blog-system"
    },
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "blog-archive"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  }
}
