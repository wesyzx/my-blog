{
  "name": "guanyan-workouts",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guanyan-workouts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "guanyan-workouts-snapshots"
    }
  ],
  "vars": {
    "SNAPSHOT_KEY": "v1/workouts.json",
    "SOURCE_NAME": "upstream",
    "PUBLIC_ORIGIN": "https://guanyan.me"
  }
}
