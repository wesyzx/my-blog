{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "dotenv -e .env.local -- node scripts/bundle-data.mjs",
    "dev": "dotenv -e .env.local -- next dev",
    "prebuild": "node scripts/bundle-data.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint",
    "deploy": "dotenv -e .env.local -- node scripts/trigger-deploy.mjs"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@notionhq/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "^17.4.2",
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.5",
    "next-mdx-remote": "^6.0.0",
    "notion-to-md": "^3.1.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-photo-album": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
