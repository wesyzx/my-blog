{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "postcss-selector-parser": "7.1.6",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "predev": "dotenv -e .env.local -- node scripts/bundle-data.mjs",
    "dev": "dotenv -e .env.local -- next dev",
    "prebuild": "node scripts/bundle-data.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint",
    "test": "node --test test/*.test.mjs",
    "obsidian:preview": "node scripts/obsidian-preview.mjs",
    "obsidian:publish": "node scripts/obsidian-publish.mjs",
    "deploy": "dotenv -e .env.local -- node scripts/trigger-deploy.mjs"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@notionhq/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "^17.4.2",
    "next": "16.3.8",
    "next-mdx-remote": "^6.0.0",
    "notion-to-md": "^3.1.9",
    "photoswipe": "^5.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-photo-album": "^3.6.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
